# Copy to .env (git ignores it) and fill in what you need. Nothing here is required to build or test Vikaki.
# Never put a real key in this file. The scripts read these from the environment; scripts/tts-bench.ts loads .env itself.

# RunPod: only for the Chatterbox spike (VIK-143). Use a dedicated key with a limited scope that you can revoke.
RUNPOD_API_KEY=

# Hosted voices for the bench (docs/tts-providers.md). Leave blank to skip that engine.
OPENAI_API_KEY=

# A self-hosted voice server with an OpenAI-style /v1/audio/speech route. The spike's scripts fill these in for a pod they start.
CHATTERBOX_URL=
CHATTERBOX_API_KEY=
QWEN_TTS_URL=
QWEN_TTS_API_KEY=
