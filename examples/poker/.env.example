# Copy to `.env` in this folder (examples/poker) and put your key after the equals sign:
#   cp examples/poker/.env.example examples/poker/.env
# `.env` is git-ignored. The key is read from the environment only, goes only into the request's Authorization header, and is never logged.
# A variable that is already exported in your shell wins over this file.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=
